# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit a populated `.env`.
# Every value here is read at runtime; nothing is hard-coded in contracts.
# ---------------------------------------------------------------------------

# --- Deployer key ---------------------------------------------------------
# Testnet-only key. NEVER use a key that holds mainnet funds.
# Hardhat derives the Anvil/Hardhat default accounts separately.
DEPLOYER_PRIVATE_KEY=

# --- L1: Ethereum Sepolia (chainId 11155111) ------------------------------
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# --- L2 option A: Polygon Amoy (chainId 80002) ----------------------------
# Note: Polygon Mumbai is deprecated; Amoy is its replacement.
AMOY_RPC_URL=
POLYGONSCAN_API_KEY=

# --- L2 option B: Arbitrum Sepolia (chainId 421614) -----------------------
ARBITRUM_SEPOLIA_RPC_URL=
ARBISCAN_API_KEY=

# --- IPFS / Pinata --------------------------------------------------------
# Used by the backend evidence-upload proxy. Without these the backend runs in
# "local IPFS stub" mode and records CIDs but does not actually pin.
PINATA_JWT=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud

# --- Veramo identity agent ------------------------------------------------
# 32-byte hex private key used by the DID:ethr issuer agent. Testnet only.
VERAMO_AGENT_PRIVATE_KEY=
VERAMO_ISSUER_DID=
VERAMO_ISSUER_KEYSTORE_PASSWORD=

# --- Backend --------------------------------------------------------------
PORT=4000
NODE_ENV=development
BACKEND_JWT_SECRET=change-me-in-production
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/app.db
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
# Number of block confirmations the indexer waits before finalising an event.
INDEXER_CONFIRMATIONS=3

# --- ML service -----------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000
ML_RISK_THRESHOLD=70

# --- Benchmarks -----------------------------------------------------------
# Stated assumptions, recorded so results are reproducible and auditable.
# Re-price any published figure if these change.
BENCH_GAS_PRICE_L1_GWEI=10
BENCH_GAS_PRICE_L2_GWEI=0.05
BENCH_ETH_USD=2500
GAS_REPORT_GAS_PRICE=20