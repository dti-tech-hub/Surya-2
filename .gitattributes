# Normalise line endings so cross-platform edits do not produce whole-file diffs.
* text=auto eol=lf

*.sol   text diff=sol
*.ts    text
*.js    text
*.json  text
*.md    text
*.yml   text
*.yaml  text

# Keep Windows scripts in native form.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets that must never be line-ending-mangled.
*.png   binary
*.jpg   binary
*.pkl   binary
*.joblib binary