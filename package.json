{
  "name": "blockchain-crowdfunding-trust",
  "version": "1.0.0",
  "description": "Blockchain-Based Trust Management Frameworks in Crowdfunding: milestone escrow, DID/VC identity, on-chain reputation, stake-weighted dispute resolution",
  "license": "MIT",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "gas-report": "REPORT_GAS=true hardhat test",
    "clean": "hardhat clean",
    "slither": "slither . --print human-summary",
    "lint:contracts": "prettier --check \"contracts/**/*.sol\"",
    "lint:ts": "eslint . --ext .ts",
    "format": "prettier --write \"contracts/**/*.sol\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "chai": "^4.5.0",
    "ethers": "^6.13.0",
    "hardhat": "^2.26.0",
    "hardhat-gas-reporter": "^2.3.0",
    "prettier": "^3.4.0",
    "prettier-plugin-solidity": "^1.4.2",
    "solidity-coverage": "^0.8.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0"
  }
}