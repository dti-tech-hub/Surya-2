{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["./hardhat.config.ts", "./scripts", "./test", "./benchmarks"],
  "exclude": ["node_modules", "dist", "backend", "frontend", "ml-service"]
}